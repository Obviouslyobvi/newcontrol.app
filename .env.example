# NewControl environment variables.
# Copy to .env.local for local development, and add each value in
# Vercel → Project → Settings → Environment Variables for production.
# See SETUP.md for a step-by-step walkthrough of creating each account.

# ── Database (Neon PostgreSQL) — required for accounts & campaigns ──
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ── Auth — required. Generate with: openssl rand -hex 32 ──
JWT_SECRET=generate-a-64-char-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── AI (Anthropic) — required for real letter generation ──
# Without a key, the app runs in a clearly-labeled sample-output mode.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=8192

# ── File storage (Cloudflare R2 or AWS S3) — optional ──
# Without it, exports download directly instead of being stored.
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=newcontrol-uploads
S3_PUBLIC_URL=https://files.newcontrol.app

# ── Email (Resend) — optional. Without it, emails are skipped. ──
RESEND_API_KEY=re_...
FROM_EMAIL=hello@newcontrol.app

# ── Payments — plug in later (Stripe or LemonSqueezy) ──
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# LEMONSQUEEZY_API_KEY=...
# LEMONSQUEEZY_WEBHOOK_SECRET=...

# ── App ──
NEXT_PUBLIC_APP_URL=https://newcontrol.app
NEXT_PUBLIC_APP_NAME=NewControl
